ENV=development
DEBUG=true

# Dev (Termux) — SQLite, no native compile required
DATABASE_URL=sqlite+aiosqlite:///./saeos_dev.db
# Production — Postgres (deploy on Linux/cloud host, not Termux)
# DATABASE_URL=postgresql+asyncpg://saeos:password@localhost:5432/saeos

JWT_SECRET=replace-with-a-long-random-secret
EVENT_BUS_BACKEND=memory
# EVENT_BUS_BACKEND=redis   # production only

ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
VOYAGE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Phase 4: async workflow execution (production only, needs celery+redis) ---
# CELERY_BROKER_URL=redis://localhost:6379/1
# WORKFLOW_ASYNC_ENABLED=true

# --- Phase 4: pgvector (production only, needs Postgres + the vector extension) ---
# VECTOR_STORE_BACKEND=pgvector   # default: memory (pure-Python, Termux-safe)
# VECTOR_DIMENSIONS=768           # must match your embedding model's output size
